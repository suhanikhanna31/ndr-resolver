# Which model provider to use: gemini (free tier via Google AI Studio) | anthropic
NDR_PROVIDER=gemini

# Gemini: key from https://aistudio.google.com (Get API key). Do not enable billing if you want the free tier.
GEMINI_API_KEY=your-gemini-key-here
# Pick a Flash / Flash-Lite model that is free on your project (see AI Studio)
GEMINI_MODEL=gemini-2.5-flash-lite

# Anthropic (only needed when NDR_PROVIDER=anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model used for extraction (defaults to Haiku if unset)
NDR_MODEL=claude-haiku-4-5-20251001

# Postgres with pgvector. Unset = no persistence, no retrieval feedback loop.
DATABASE_URL=postgresql://ndr:ndr@localhost:5432/ndr

# Redis for the async job queue. Unset = /v1/ndr/jobs returns 503.
REDIS_URL=redis://localhost:6379

# Embeddings: fastembed (local, default) | openai (needs langchain-openai + OPENAI_API_KEY) | fake (tests only)
EMBEDDINGS_PROVIDER=fastembed
# EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Retrieval tuning: how many examples, and the max cosine distance to accept (lower = stricter)
RETRIEVAL_K=3
RETRIEVAL_MAX_DISTANCE=0.35

# If set, every /v1 endpoint requires header X-API-Key: <value>. Set this in any shared environment.
API_KEY=

# WhatsApp Cloud API adapter (optional). See README "WhatsApp channel".
WHATSAPP_VERIFY_TOKEN=          # any string you also enter in Meta's webhook setup
WHATSAPP_APP_SECRET=            # Meta app secret; POST /webhooks/whatsapp returns 503 without it
WHATSAPP_ACCESS_TOKEN=          # unset = decisions still run, replies are not sent
WHATSAPP_PHONE_NUMBER_ID=
